{
  "manifest_version": 3,
  "name": "Minimize - Browser Tracker",
  "version": "1.0.0",
  "description": "Tracks browsing activity for the Minimize dashboard. All data stays local.",
  "permissions": ["tabs", "activeTab"],
  "host_permissions": ["http://127.0.0.1:8742/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Minimize Tracker"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
